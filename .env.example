# ==========================================
# VARIÁVEIS DE AMBIENTE - CURRÍCULO WEB
# ==========================================

# [FRONTEND / VERCEL]
# Configure na Vercel (Project Settings -> Environment Variables)
# Pode informar com ou sem /api no final
VITE_API_URL=http://localhost:5000

# [BACKEND / SERVER]
# Configure na Vercel (Project Settings -> Environment Variables)
PORT=5000
HOST=0.0.0.0
CLIENT_URL=*

# [BANCO DE DADOS TURSO / LIBSQL]
# Obtenha em https://turso.tech/
TURSO_DATABASE_URL=libsql://seu-banco-usuario.turso.io
TURSO_AUTH_TOKEN=seu-token-gerado-no-turso

